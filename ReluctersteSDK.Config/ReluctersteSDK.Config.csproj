<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ReluctersteSDK.Config</PackageId>
    <AssemblyName>ReluctersteSDK.Config</AssemblyName>
    <RootNamespace>ReluctersteSDK.Config</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<Version>0.13.0.0</Version>
	<Authors>Xue-Remake</Authors>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
	<Copyright>Copyright © 2026 Xue-Remake &lt;xuemincanremake@gmail.com&gt;. All rights reserved.</Copyright>
	<Description>配置存储抽象层：统一的 IConfigStore 契约，可换用内存、JSON 文件或 SQLite 后端，配套批量保存结果与取消支持。</Description>
	<PackageOutputPath>E:\Work\资产仓库\NuGetPackage</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReluctersteSDK.Paths\ReluctersteSDK.Paths.csproj" />
    <ProjectReference Include="..\ReluctersteSDK.Sqlite\ReluctersteSDK.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
  </ItemGroup>

</Project>
